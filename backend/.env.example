# Copy to .env and fill in. NEVER commit .env.

APP_ENV=development
DEBUG=true

# Mounts the pricing calculator at /dev/calculator for checking hand
# calculations against the engine. Force-disabled when APP_ENV=production.
ENABLE_DEV_TOOLS=true

# Neon
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Upstash
REDIS_URL=redis://default:password@host:6379

# --- Pricing -----------------------------------------------------------------
# The formula's tunables. Changing GST_RATE also changes the invoice line label.
GST_RATE=0.03
DEFAULT_MAKING_RATE=1100
# two_decimals | nearest_rupee
# OPEN ITEM: client has not confirmed nearest-rupee. Flip this one value.
ROUNDING=two_decimals

# Price-lock and stock-reservation TTLs, in seconds (P3).
PRICE_LOCK_TTL_SECONDS=900
STOCK_RESERVATION_TTL_SECONDS=900

# --- Auth --------------------------------------------------------------------
# Interim gate for the admin rate screen until P3 ships real sessions.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Razorpay (P3) -----------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudflare R2 (P2) ------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- WhatsApp Business (P4) --------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Comma-separated
CORS_ORIGINS=["http://localhost:3000"]
